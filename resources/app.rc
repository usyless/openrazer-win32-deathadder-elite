#include <winver.h>
#include <da_elite_version.h>
#include "resource.h"

IDI_APP_ICON ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     DA_ELITE_VERSION_MAJOR,DA_ELITE_VERSION_MINOR,DA_ELITE_VERSION_PATCH,DA_ELITE_VERSION_TWEAK
PRODUCTVERSION  DA_ELITE_VERSION_MAJOR,DA_ELITE_VERSION_MINOR,DA_ELITE_VERSION_PATCH,DA_ELITE_VERSION_TWEAK
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "usy"
            VALUE "FileDescription",  "Razer DeathAdder Elite Controller"
            VALUE "FileVersion",      DA_ELITE_VERSION_STR
            VALUE "InternalName",     "da-elite.exe"
            VALUE "OriginalFilename", "da-elite.exe"
            VALUE "ProductName",      "DeathAdder Elite"
            VALUE "ProductVersion",   DA_ELITE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
